import random
import json
import base64

def create_insecure_jwt(email, is_admin):
    """Generates an unsigned JWT (alg: none), a classic critical vulnerability."""
    header = {
        "alg": "none", 
        "typ": "JWT"
    }
    payload = {
        "sub": email,
        "role": "admin" if is_admin else "user",
        "logged_in_as": email,
        # Tokens should expire, but unsafe ones often don't!
        "exp": 9999999999 
    }
    
    # JWTs are just Base64Url encoded JSON strings separated by dots
    header_b64 = base64.urlsafe_b64encode(json.dumps(header).encode()).decode().rstrip("=")
    payload_b64 = base64.urlsafe_b64encode(json.dumps(payload).encode()).decode().rstrip("=")
    
    # An unsigned JWT ends with a dot but has no signature attached
    return f"{header_b64}.{payload_b64}."

def generate_unsafe_data(num_records=10):
    """Generates fake user data loaded with common security vulnerabilities."""
    
    hostile_names = [
        "Robert'); DROP TABLE Users;--",   
        "' OR '1'='1",                     
        "<script>alert('XSS')</script>",   
        "../../../etc/passwd"              
    ]
    
    terrible_passwords = ["123456", "password", "admin", "welcome1"]
    domains = ["vulnerable.local", "test.box"]

    data = []
    for i in range(num_records):
        fname = random.choice(hostile_names)
        lname = random.choice(hostile_names)
        email = f"test_user_{i}@{random.choice(domains)}"
        is_admin_flag = random.choice([True, False])
        
        user = {
            "first_name": fname,
            "last_name": lname,
            "email": email,
            "password": random.choice(terrible_passwords),
            "is_admin": is_admin_flag,
            
            # --- UNSAFE AUTHENTICATION DATA ---
            
            # 1. Unsigned JWT (Cleartext JSON encoded as Base64)
            "jwt_token": create_insecure_jwt(email, is_admin_flag),
            
            # 2. Hardcoded / Predictable Session Token (Highly vulnerable to brute-force)
            "session_id": f"SESSION_ID_{i:04d}_{email}",
            
            # 3. Cleartext API Key (Looks sensitive, stored without hashing)
            "api_key": f"AKIA{random.choice('ABCDEFGHIJKLMNOPQRSTUVWXYZ')}FAKEKEY{random.randint(1000,9999)}"
        }
        data.append(user)

    return data

